{
  "name": "commerceguard",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-driven release quality gates for the pinned Medusa DTC Starter",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "aut:prepare": "node scripts/aut.mjs prepare",
    "aut:init": "node scripts/aut.mjs init",
    "aut:start": "node scripts/aut.mjs start",
    "aut:stop": "node scripts/aut.mjs stop",
    "aut:ready": "node scripts/aut.mjs ready",
    "aut:seed": "node scripts/aut.mjs seed",
    "db:portable": "node scripts/portable-db.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\" --project=api --project=integration --project=chromium",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:stability": "playwright test --grep \"@smoke\" --project=api --project=integration --project=chromium --repeat-each=3",
    "test:defects": "node scripts/defects.mjs",
    "defect:reproduce": "node scripts/reproduce-quantity.mjs",
    "test:perf": "node scripts/performance.mjs",
    "report": "playwright show-report",
    "report:summary": "node scripts/summarize.mjs",
    "evidence:screenshots": "node scripts/capture-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "pg": "^8.0.0",
    "pnpm": "10.11.1",
    "prettier": "^3.0.0",
    "typescript": "7.0.2",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
